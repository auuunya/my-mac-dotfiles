[user]
    name = Your Name
    email = your-email@example.com

[include]
    path = ~/.gitconfig.local

[http]
    postBuffer = 524288000

[core]
    pager = delta
    editor = vim

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = lazygit
    df = diff
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    wip = !git add -A && git commit -m "wip"
    stashes = stash list
