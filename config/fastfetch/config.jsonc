{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan",
            "title": "yellow"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "at": "white",
                "host": "yellow"
            }
        },
        {
            "type": "separator",
            "string": "─────────────────────"
        },
        {
            "type": "os",
            "key": "  󰀵 OS",
            "format": "{2} {11}"
        },
        {
            "type": "kernel",
            "key": "  󰌽 Kernel"
        },
        {
            "type": "uptime",
            "key": "  󰔟 Uptime"
        },
        {
            "type": "packages",
            "key": "  󰏗 Packages"
        },
        {
            "type": "shell",
            "key": "  󰆍 Shell"
        },
        {
            "type": "terminal",
            "key": "  󰆍 Terminal"
        },
        {
            "type": "terminalfont",
            "key": "  󰛖 Font"
        },
        {
            "type": "separator",
            "string": "─────────────────────"
        },
        {
            "type": "cpu",
            "key": "  󰻠 CPU",
            "format": "{1} ({5}) @ {7}"
        },
        {
            "type": "gpu",
            "key": "  󰍛 GPU"
        },
        {
            "type": "memory",
            "key": "  󰍛 Memory"
        },
        {
            "type": "disk",
            "key": "  󰋊 Disk (/)",
            "folders": "/"
        },
        {
            "type": "separator",
            "string": "─────────────────────"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
